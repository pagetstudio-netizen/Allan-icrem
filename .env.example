# Base de données Supabase (obligatoire)
SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Session (clé secrète — générer une chaîne aléatoire longue)
SESSION_SECRET=changeme_utilisez_une_cle_longue_et_aleatoire

# Mot de passe administrateur (optionnel — défaut: pagetstudio)
# ADMIN_PASSWORD=pagetstudio

# Port (optionnel — défaut: 5000)
# PORT=3000
